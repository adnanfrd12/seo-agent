{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ai",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/research",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/extras",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/cron/quick-wins?phase=submit",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/quick-wins?phase=collect",
      "schedule": "0 11 * * *"
    }
  ]
}
