# Supabase (project: seo-agent)
NEXT_PUBLIC_SUPABASE_URL=https://whkrbtlfnqniyiylktuz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Composio (server only)
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_GA4=
COMPOSIO_AUTH_CONFIG_GSC=
# Pin toolkit versions (recommended). If unset, calls skip the version check.
COMPOSIO_TOOLKIT_VERSION_GOOGLE_ANALYTICS=
COMPOSIO_TOOLKIT_VERSION_GOOGLE_SEARCH_CONSOLE=

# Direct Google Business Profile adapter (Composio has no GBP toolkit)
GOOGLE_GBP_CLIENT_ID=
GOOGLE_GBP_CLIENT_SECRET=
# must match an Authorized redirect URI on the OAuth client exactly
GOOGLE_GBP_REDIRECT_URI=https://your-app.example.com/api/integrations/gbp/callback
# 32-byte key, base64, used to encrypt stored GBP refresh tokens
TOKEN_ENCRYPTION_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret the scheduler sends to /api/cron/sync
CRON_SECRET=

# AI insights, 30-day strategy and PDF import (server only)
ANTHROPIC_API_KEY=
# Encrypts stored third-party tokens (Microsoft Clarity). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Local server-side PDF export only (Vercel uses the bundled Chromium automatically)
CHROME_EXECUTABLE_PATH=
